# Backend — copy to .env and adjust for your environment
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# Server (also overridable via: python run.py --host ... --port ...)
HOST=0.0.0.0
PORT=8000

# Directory for .pth model files (relative to backend/ when running locally)
MODELS_DIR=models

# Comma-separated allowed browser origins for CORS (use * only in local dev)
# Example production: https://my-app.vercel.app,https://www.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PyTorch device: cuda | cpu | (empty = auto: cuda if available else cpu)
TORCH_DEVICE=
